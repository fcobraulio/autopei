metry relative="1" as="geometry"><Array as="points"><mxPoint x="905" y="440"/><mxPoint x="1290" y="440"/></Array></mxGeometry></mxCell><mxCell id="c107" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#455A64;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="d2" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="585"/><mxPoint x="1685" y="585"/></Array></mxGeometry></mxCell><mxCell id="c108" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#455A64;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="n3" target="d3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="905" y="440"/><mxPoint x="1450" y="440"/></Array></mxGeometry></mxCell><mxCell id="c109" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#455A64;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="d3" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1450" y="585"/><mxPoint x="1685" y="585"/></Array></mxGeometry></mxCell><mxCell id="c110" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#455A64;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n5" target="d"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tc" value="todos concluíram" style="text;html=1;fontSize=11;fontColor=#455A64;" vertex="1" parent="1"><mxGeometry x="1690" y="570" width="110" height="20" as="geometry"/></mxCell><mxCell id="c111" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#455A64;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="d" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c112" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#455A64;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c113" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#455A64;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c114" value="após as assinaturas" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#455A64;fontSize=11;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n8" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c115" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#455A64;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#C62828;fontColor=#C62828;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="d" target="n2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1900" y="10"/><mxPoint x="665" y="10"/></Array></mxGeometry></mxCell><mxCell id="lbl" value="Não: devolve só para quem precisa corrigir — depois volta direto à revisão" style="text;html=1;fontSize=11;fontColor=#C62828;align=center;" vertex="1" parent="1"><mxGeometry x="950" y="-16" width="560" height="20" as="geometry"/></mxCell><mxCell id="c116" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#455A64;fontSize=11;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#C62828;fontColor=#C62828;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="d" target="n3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1900" y="10"/><mxPoint x="905" y="10"/></Array></mxGeometry></mxCell>
<mxCell id="nota" value="&lt;b&gt;Correções:&lt;/b&gt; o PEI devolvido volta &lt;u&gt;apenas&lt;/u&gt; para a etapa escolhida (Psicopedagogia, ETEP ou um docente) e, depois de corrigido, retorna direto para a revisão — sem refazer a cadeia, a não ser que o(a) gestor(a) marque isso explicitamente.&lt;br&gt;&lt;b&gt;Distribuição:&lt;/b&gt; os docentes recebem o PEI pela associação &lt;i&gt;código da disciplina ↔ docente&lt;/i&gt;; disciplina sem docente aparece como alerta no painel.&lt;br&gt;&lt;b&gt;Anexos&lt;/b&gt; (laudos, notificações, provas) são internos e não entram no DOCX. &lt;b&gt;Semestre seguinte:&lt;/b&gt; o novo PEI do estudante já vem pré-preenchido.&lt;br&gt;&lt;b&gt;Auxiliar&lt;/b&gt; cadastra, associa disciplinas e devolve; &lt;b&gt;aprovar, registrar, cancelar, encerrar semestre e gerir acessos&lt;/b&gt; são exclusivos do(a) gestor(a)." style="text;html=1;whiteSpace=wrap;fontSize=11;fillColor=#FAFAFA;strokeColor=#BDBDBD;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="770" width="1500" height="90" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>