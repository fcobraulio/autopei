# ---------------------------------------------------------------- Banco de dados
DATABASE_URL=postgresql+psycopg://autopei:autopei@localhost:5432/autopei

# ---------------------------------------------------------------- Administrador inicial (conta local)
# Conta local criada automaticamente na primeira execução (se ainda não existir).
AUTOPEI_ADMIN_USERNAME=admin
AUTOPEI_ADMIN_PASSWORD=TroqueEstaSenha123
AUTOPEI_ADMIN_NOME=Administrador(a) AutoPEI
# Matrículas SUAP que viram administradoras ao entrar (separadas por vírgula)
AUTOPEI_ADMINS_SUAP=

# ---------------------------------------------------------------- SUAP (OAuth2)
# Cadastre a aplicação em https://suap.ifrn.edu.br/api/ (Authorization grant type: Authorization code)
# com o Redirect URI IGUAL ao SUAP_REDIRECT_URI abaixo (o endereço do AutoPEI).
SUAP_URL=https://suap.ifrn.edu.br
SUAP_CLIENT_ID=
SUAP_CLIENT_SECRET=
SUAP_REDIRECT_URI=http://localhost:8501/
# Rotas que retornam os dados da pessoa logada (testadas em ordem)
SUAP_ME_ENDPOINTS=/api/rh/eu/,/api/eu/
# Escopos (vazio = os da aplicação no SUAP)
SUAP_OAUTH_SCOPE=
# Chave para assinar o parâmetro "state" do login (gere uma aleatória: python -c "import secrets;print(secrets.token_hex(32))")
AUTOPEI_SECRET_KEY=

# SOMENTE DESENVOLVIMENTO: mostra um simulador do retorno do SUAP na tela de login. Nunca use em produção.
AUTOPEI_SUAP_FAKE=0

# ---------------------------------------------------------------- Anexos
AUTOPEI_ANEXO_MAX_MB=10

# ---------------------------------------------------------------- Instituição
AUTOPEI_CAMPUS_INICIAL=Currais Novos
AUTOPEI_CAMPUS_INICIAL_SIGLA=CN
